# Copy to .env in the Backend directory. Development credentials only.
# Plain KEY=value; do not add shell commands, export, or surrounding quotes.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/foodtime_neo?currentSchema=foodtime
DB_USERNAME=foodtime
DB_PASSWORD=foodtime_local_only
# Used by local Docker Compose (DB_URL controls the application separately).
POSTGRES_DB=foodtime_neo
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_only
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Production: set SPRING_PROFILES_ACTIVE=prod, replace ALL credentials/hosts,
# specify trusted web origins, and enable TLS as appropriate.
# DB_POOL_MIN_IDLE=2
# DB_POOL_MAX_SIZE=10
# DB_CONNECTION_TIMEOUT=30000
# REDIS_USERNAME=
# REDIS_CONNECT_TIMEOUT=3s
# REDIS_TIMEOUT=3s
# REDIS_POOL_MAX_ACTIVE=8
# TOMCAT_MAX_THREADS=200
# UPLOAD_MAX_FILE_SIZE=10MB
# UPLOAD_MAX_REQUEST_SIZE=20MB
# LOG_FILE=logs/foodtime-neo-backend.log
# SERVER_ADDRESS=0.0.0.0
# FORWARD_HEADERS_STRATEGY=none
# RATING_SUMMARY_REFRESH_ENABLED=true
# RATING_SUMMARY_REFRESH_INTERVAL=PT24H
# RATING_SUMMARY_INITIAL_DELAY=PT0S

# Login sessions: fixed lifetime, host-only HttpOnly SameSite=Lax cookie.
# Secure is true in production and false by default in development.
# AUTH_SESSION_TTL=P7D
# AUTH_COOKIE_SECURE=true
# SESSION_REDIS_NAMESPACE=foodtime:session
# AUTH_LOGIN_WINDOW=PT15M
# AUTH_LOGIN_ACCOUNT_LIMIT=10
# AUTH_LOGIN_IP_LIMIT=100
# AUTH_REDIS_NAMESPACE=foodtime:auth:login

# Email verification: preferably copy config/mail.example.yml to config/mail.yml.
# Fill the real sender/SMTP credentials and secret, then enable it. Missing SMTP never bypasses verification.
# EMAIL_VERIFICATION_ENABLED=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=sender@example.com
# MAIL_PASSWORD=your_smtp_authorization_password
# MAIL_FROM=sender@example.com
# EMAIL_VERIFICATION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# MAIL_STARTTLS_ENABLED=true
# MAIL_STARTTLS_REQUIRED=true
# MAIL_SSL_ENABLED=false
# EMAIL_RESEND_INTERVAL=PT60S
# EMAIL_SEND_WINDOW=PT15M
# EMAIL_SEND_ACCOUNT_LIMIT=5
# EMAIL_SEND_IP_LIMIT=20
# EMAIL_VERIFICATION_NAMESPACE=foodtime:auth:email
