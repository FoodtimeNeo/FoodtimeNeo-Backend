# Copy to .env in the Backend directory. Development credentials only.
# Plain KEY=value; do not add shell commands, export, or surrounding quotes.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/foodtime_neo?currentSchema=foodtime
DB_USERNAME=foodtime
DB_PASSWORD=foodtime_local_only
# Used by local Docker Compose (DB_URL controls the application separately).
POSTGRES_DB=foodtime_neo
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_only
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Production: set SPRING_PROFILES_ACTIVE=prod, replace ALL credentials/hosts,
# specify trusted web origins, and enable TLS as appropriate.
# DB_POOL_MIN_IDLE=2
# DB_POOL_MAX_SIZE=10
# DB_CONNECTION_TIMEOUT=30000
# REDIS_USERNAME=
# REDIS_CONNECT_TIMEOUT=3s
# REDIS_TIMEOUT=3s
# REDIS_POOL_MAX_ACTIVE=8
# JVM堆：2核4G单机用 -Xms768m -Xmx1280m（见 compose.prod.yml 与 docs/deployment.md）；
# 本地开发不设即用容器默认。Dockerfile 入口已支持 JAVA_OPTS。
# JAVA_OPTS=-Xms768m -Xmx1280m -XX:+UseG1GC
# TOMCAT_MAX_THREADS 默认200；2核生产单机用50（compose.prod.yml 已设）。
# TOMCAT_MAX_THREADS=200
# UPLOAD_MAX_FILE_SIZE=10MB
# UPLOAD_MAX_REQUEST_SIZE=20MB
# LOG_FILE=logs/foodtime-neo-backend.log
# SERVER_ADDRESS=0.0.0.0
# 反向代理之后必须设为 framework 并由代理覆写 X-Forwarded-For，直连保持 none。
# 否则全校用户共用每IP限流配额。详见 docs/deployment.md 反向代理一节。
# FORWARD_HEADERS_STRATEGY=none

# Login sessions: fixed lifetime, host-only HttpOnly SameSite=Lax cookie.
# Secure is true in production and false by default in development.
# AUTH_SESSION_TTL=P7D
# AUTH_COOKIE_SECURE=true
# SESSION_REDIS_NAMESPACE=spring:session
# AUTH_LOGIN_WINDOW=PT15M
# AUTH_LOGIN_ACCOUNT_LIMIT=10
# AUTH_LOGIN_IP_LIMIT=100
# AUTH_REDIS_NAMESPACE=foodtime:auth:login

# Password change limits are independent of login and registration limits.
# PASSWORD_CHANGE_WINDOW=PT15M
# PASSWORD_CHANGE_USER_LIMIT=5
# PASSWORD_CHANGE_IP_LIMIT=50
# PASSWORD_CHANGE_REDIS_NAMESPACE=foodtime:auth:password-change

# Email verification: preferably copy config/mail.example.yml to config/mail.yml.
# Fill the real sender/SMTP credentials and secret, then enable it for real emailed codes.
# Registration always requires a real emailed code in every environment.
# EMAIL_VERIFICATION_ENABLED=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=sender@example.com
# MAIL_PASSWORD=your_smtp_authorization_password
# MAIL_FROM=sender@example.com
# EMAIL_VERIFICATION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# MAIL_STARTTLS_ENABLED=true
# MAIL_STARTTLS_REQUIRED=true
# MAIL_SSL_ENABLED=false
# EMAIL_RESEND_INTERVAL=PT60S
# EMAIL_SEND_WINDOW=PT15M
# EMAIL_SEND_ACCOUNT_LIMIT=5
# EMAIL_SEND_IP_LIMIT=20
# EMAIL_VERIFICATION_NAMESPACE=foodtime:auth:email
# 注册邮箱存在性预检：连接学校 SMTP 465 做 RCPT，不发信；550 静默返回 202 且不消耗发送配额；
# 探测超时/异常 fail-open 继续发码。默认关闭，按部署环境开启。
# EMAIL_MAILBOX_VERIFY_ENABLED=true
# EMAIL_MAILBOX_VERIFY_HOST=smg.bjtu.edu.cn
# EMAIL_MAILBOX_VERIFY_PORT=465
# EMAIL_MAILBOX_VERIFY_TIMEOUT=PT3S
# EMAIL_MAILBOX_VERIFY_CACHE_TTL=PT10M
# EMAIL_MAILBOX_VERIFY_CACHE_NAMESPACE=foodtime:auth:mailbox

# Content write throttles (per user / per IP) and orphan staged-image cleanup.
# SUBMISSION_WINDOW=PT15M
# SUBMISSION_USER_LIMIT=20
# SUBMISSION_IP_LIMIT=2000
# SUBMISSION_REDIS_NAMESPACE=foodtime:content:submissions
# UPLOAD_WINDOW=PT1H
# UPLOAD_USER_LIMIT=10
# UPLOAD_IP_LIMIT=1000
# UPLOAD_REDIS_NAMESPACE=foodtime:content:uploads
# Community like/favorite/repost throttle (independent of submission throttle).
# COMMUNITY_ACTION_WINDOW=PT1M
# COMMUNITY_ACTION_USER_LIMIT=100
# COMMUNITY_ACTION_IP_LIMIT=1000
# COMMUNITY_ACTION_REDIS_NAMESPACE=foodtime:community:actions
# STORAGE_CLEANUP_ENABLED=true
# STORAGE_CLEANUP_INTERVAL=PT24H
# STORAGE_CLEANUP_MAX_AGE=P7D

# Monitoring: Prometheus scrape allowlist (IP or CIDR; empty denies all scrapes)
# and slow-request log threshold in whole seconds.
# MONITORING_SCRAPE_IP=127.0.0.1
# SLOW_REQUEST_THRESHOLD=PT2S
# STORAGE_DISK_WARN_BYTES=1073741824
# 在线用户：TTL 内有已认证请求的去重用户数（看板 onlineUsers）
# DASHBOARD_PRESENCE_TTL=PT5M
# DASHBOARD_PRESENCE_NAMESPACE=foodtime:presence

# AI triage: async risk screening for pending reviews and photos. Disabled by default;
# enable only with a configured OpenAI-compatible endpoint. The fake provider never
# calls the network and is for local development and tests only.
# AI_TRIAGE_ENABLED=true
# AI_TRIAGE_PROVIDER=openai
# AI_TRIAGE_BASE_URL=https://api.example.com/v1
# AI_TRIAGE_API_KEY=replace_with_provider_key
# 多个key用英文逗号分隔（无空格要求），逐请求轮询、401/403/429自动切换。
# 例：AI_TRIAGE_API_KEY=key1,key2,key3
# 生产建议同样用 systemd 加密凭据注入 AI_TRIAGE_API_KEY，见 docs/secrets.md。
# AI_TRIAGE_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
# AI_TRIAGE_ESCALATION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# AI_TRIAGE_FALLBACK_MODEL=z-ai/glm-5.3-flash
# AI_TRIAGE_ESCALATION_BELOW_CONFIDENCE=0.9
# AI_TRIAGE_PHOTO_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# LOW且置信度达到此值自动通过、HIGH且置信度达到此值自动驳回；其余留给人工。
# 社区帖子使用单独的自动通过阈值（默认 0.85），评论/点评/回复仍用上面的 0.95。
# AI_TRIAGE_AUTO_APPROVE_ABOVE=0.95
# AI_TRIAGE_COMMUNITY_APPROVE_ABOVE=0.85
# AI_TRIAGE_AUTO_REJECT_ABOVE=0.9
# 模型映射覆盖的 Redis 命名空间；monitor 进程写这里实现不停机换模型。
# AI_TRIAGE_REDIS_NAMESPACE=foodtime:ai:triage
# AI_TRIAGE_TIMEOUT=PT30S
# AI_TRIAGE_BATCH_SIZE=10
# 即时审核线程池（新投稿先走即时路径；队列满才由下面的扫批兜底）
# AI_TRIAGE_POOL_CORE=4
# AI_TRIAGE_POOL_MAX=8
# AI_TRIAGE_POOL_QUEUE=500
# 兜底扫批周期与启动延迟：默认 30 秒一批、启动后 5 秒首跑
# AI_TRIAGE_INTERVAL=PT30S
# AI_TRIAGE_INITIAL_DELAY=PT5S

# 单key直判：同一个key同一个模型处理全部审核（点评、图片、社区评论）。
# 启用后多key轮询、升级复核、兜底模型、Redis模型映射与超管热切换一律不再进入；
# 关掉本开关即回到上面的 triage 链路，旧变量保留不用删。
# 配服的人：下面 base-url 与 model 已是当前指定的 deepseek 值，直接用；
# key 由 systemd 加密凭据注入（scripts/security/set-ai-single-key.sh），
# 不要写进 .env 或提交；详见 docs/secrets.md。再按需打开 ENABLED。
# AI_SINGLE_ENABLED=true
AI_SINGLE_BASE_URL=https://api.deepseek.com
# AI_SINGLE_API_KEY 不在此填写：由 systemd 加密凭据注入（见 docs/secrets.md）
# 单key内不允许英文逗号；密钥只走加密凭据或部署平台密钥，不要提交。
AI_SINGLE_MODEL=deepseek-flash
# AI_SINGLE_TIMEOUT=PT30S

# Invitation codes: optional registration attribution managed by superadmins.
# Generate a random secret of at least 32 characters; without it code creation
# and code-attributed registration return 503. See docs/api/auth/invitation-codes.md.
# INVITATION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Shared anonymous registration + email-code attempts (separate from sending quotas).
# REGISTRATION_WINDOW=PT15M
# REGISTRATION_ACCOUNT_LIMIT=10
# REGISTRATION_IP_LIMIT=1000
# REGISTRATION_REDIS_NAMESPACE=foodtime:auth:registration
# Storage includes original images, thumbnails and metadata, reconciled from disk.
# STORAGE_USER_BYTES=104857600
# STORAGE_TOTAL_BYTES=10737418240
# STORAGE_MIN_FREE_BYTES=1073741824
# STORAGE_CONCURRENT_UPLOADS=2
